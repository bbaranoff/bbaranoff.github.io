<div id="gsm-intro" aria-label="Intro d'accueil">
  <iframe class="gi-frame gi-wall" src="{{ site.baseurl }}/exemples/gsm-lab-wallpaper.html" title="GSM Lab" scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
  <img class="gi-frame gi-art" src="{{ site.baseurl }}/exemples/telecom-patchwork.gif" alt="Telecoms patchwork" />
  <button type="button" class="gi-skip">Entrer &#9654;</button>
  <div class="gi-enter">l'accueil s'ouvre… · cliquer pour passer</div>
</div>
<noscript><style>#gsm-intro{display:none!important}</style></noscript>
<style>
#gsm-intro{position:fixed;inset:0;z-index:2147483647;background:#161826;overflow:hidden;opacity:1;transition:opacity .5s ease;cursor:pointer}
#gsm-intro.gi-out{opacity:0;pointer-events:none}
#gsm-intro .gi-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#161826;pointer-events:none;opacity:0;transition:opacity .35s ease;z-index:1}
#gsm-intro .gi-wall{opacity:1}
#gsm-intro .gi-art{object-fit:cover}
#gsm-intro.gi-2 .gi-wall{opacity:0}
#gsm-intro.gi-2 .gi-art{opacity:1}
#gsm-intro .gi-skip{position:absolute;top:18px;right:18px;z-index:3;cursor:pointer;
  font:700 13px/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.16em;text-transform:uppercase;
  color:#08131a;background:#33e1d0;border:1px solid #7ff0e4;
  padding:12px 18px;border-radius:11px;box-shadow:0 8px 26px rgba(51,225,208,.45)}
#gsm-intro .gi-skip:hover{background:#5cf0e2}
#gsm-intro .gi-enter{position:absolute;bottom:18px;left:0;right:0;text-align:center;z-index:3;pointer-events:none;
  color:#9aa0c8;font:600 12px/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.22em;text-transform:uppercase;opacity:.6}
html.gi-lock,html.gi-lock body{overflow:hidden!important}
</style>
<script>
(function(){
  var el=document.getElementById('gsm-intro'); if(!el){ return; }
  function kill(){ if(el&&el.parentNode){ el.parentNode.removeChild(el); } }
  if(window.top!==window.self){ kill(); return; }
  var seen=null; try{ seen=sessionStorage.getItem('gsmIntroSeen'); }catch(e){}
  if(seen){ kill(); return; }
  try{ document.documentElement.classList.add('gi-lock'); }catch(e){}
  var done=false, t1, t2;
  function cleanup(){
    if(t1){ clearTimeout(t1); } if(t2){ clearTimeout(t2); }
    document.removeEventListener('click', skip, true);
    document.removeEventListener('keydown', skip, true);
  }
  function finish(){
    if(done){ return; } done=true;
    try{ sessionStorage.setItem('gsmIntroSeen','1'); }catch(e){}
    cleanup();
    el.classList.add('gi-out');
    try{ document.documentElement.classList.remove('gi-lock'); }catch(e){}
    setTimeout(kill, 620);
  }
  function skip(){ finish(); }
  /* déroulé AUTOMATIQUE (non bloquant) : wallpaper → gif → site */
  t1=setTimeout(function(){ if(!done){ el.classList.add('gi-2'); } }, 2200);
  t2=setTimeout(finish, 4600);
  /* clic ou touche n'importe où : entrer tout de suite */
  document.addEventListener('click', skip, true);
  document.addEventListener('keydown', skip, true);
})();
</script>
