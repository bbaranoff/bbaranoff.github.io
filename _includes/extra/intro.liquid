<div id="gsm-intro" role="button" tabindex="0" aria-label="Entrer sur le site">
  <iframe class="gi-frame gi-wall" src="{{ site.baseurl }}/exemples/gsm-lab-wallpaper.html" title="GSM Lab" scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
  <iframe class="gi-frame gi-art" src="{{ site.baseurl }}/exemples/telecom-patchwork.html" title="Télécoms patchwork" scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
  <div class="gi-enter"><span class="gi-hint">cliquer pour continuer</span> &#9654;</div>
</div>
<noscript><style>#gsm-intro{display:none!important}</style></noscript>
<style>
#gsm-intro{position:fixed;inset:0;z-index:2147483647;background:#161826;overflow:hidden;opacity:1;transition:opacity .55s ease;cursor:pointer}
#gsm-intro.gi-out{opacity:0;pointer-events:none}
#gsm-intro .gi-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#161826;pointer-events:none;opacity:0;transition:opacity .3s ease}
#gsm-intro .gi-wall{opacity:1}
#gsm-intro.gi-2 .gi-wall{opacity:0}
#gsm-intro.gi-2 .gi-art{opacity:1}
#gsm-intro .gi-enter{position:absolute;bottom:18px;left:0;right:0;text-align:center;color:#9aa0c8;font:600 12px/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.26em;text-transform:uppercase;opacity:.7;animation:gi-pulse 1.8s ease-in-out infinite;pointer-events:none}
#gsm-intro.gi-2 .gi-hint::after{content:" (2/2)"}
@keyframes gi-pulse{0%,100%{opacity:.35}50%{opacity:.85}}
html.gi-lock,html.gi-lock body{overflow:hidden!important}
</style>
<script>
(function(){
  var el=document.getElementById('gsm-intro'); if(!el) return;
  function kill(){ if(el&&el.parentNode) el.parentNode.removeChild(el); }
  // pas d'intro à l'intérieur d'un iframe (évite la récursion)
  if(window.top!==window.self){ kill(); return; }
  var seen=null; try{ seen=sessionStorage.getItem('gsmIntroSeen'); }catch(e){}
  if(seen){ kill(); return; }
  document.documentElement.classList.add('gi-lock');
  var done=false;
  function finish(){
    if(done) return; done=true;
    try{ sessionStorage.setItem('gsmIntroSeen','1'); }catch(e){}
    el.classList.add('gi-out');
    document.documentElement.classList.remove('gi-lock');
    setTimeout(kill, 650);
  }
  // clic 1 (n'importe où) : GSM Lab -> artefact ; clic 2 : artefact -> site
  function advance(){
    if(done) return;
    if(!el.classList.contains('gi-2')) el.classList.add('gi-2');
    else finish();
  }
  el.addEventListener('click', advance);
  document.addEventListener('keydown', advance);
})();
</script>
