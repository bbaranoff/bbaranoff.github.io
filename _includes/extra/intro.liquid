<div id="gsm-intro" role="button" tabindex="0" aria-label="Entrer sur le site">
  <iframe class="gi-wall" src="{{ site.baseurl }}/exemples/gsm-lab-wallpaper.html" title="GSM Lab" scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
  <div class="gi-enter">cliquer pour entrer &#9654;</div>
</div>
<noscript><style>#gsm-intro{display:none!important}</style></noscript>
<style>
#gsm-intro{position:fixed;inset:0;z-index:2147483647;background:#0c0e1a;overflow:hidden;opacity:1;transition:opacity .55s ease;cursor:pointer}
#gsm-intro.gi-out{opacity:0;pointer-events:none}
#gsm-intro .gi-wall{position:absolute;inset:0;width:100%;height:100%;border:0;background:#0c0e1a;pointer-events:none}
#gsm-intro .gi-enter{position:absolute;bottom:18px;left:0;right:0;text-align:center;color:#8b90b5;font:600 12px/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.28em;text-transform:uppercase;opacity:.7;animation:gi-pulse 1.8s ease-in-out infinite;pointer-events:none}
@keyframes gi-pulse{0%,100%{opacity:.35}50%{opacity:.85}}
html.gi-lock,html.gi-lock body{overflow:hidden!important}
</style>
<script>
(function(){
  var el=document.getElementById('gsm-intro'); if(!el) return;
  function kill(){ if(el&&el.parentNode) el.parentNode.removeChild(el); }
  // pas d'intro à l'intérieur d'un iframe (évite la récursion)
  if(window.top!==window.self){ kill(); return; }
  var seen=null; try{ seen=sessionStorage.getItem('gsmIntroSeen'); }catch(e){}
  if(seen){ kill(); return; }
  document.documentElement.classList.add('gi-lock');
  var done=false;
  // un clic (ou une touche) N'IMPORTE OÙ -> on entre sur le site
  function enter(){
    if(done) return; done=true;
    try{ sessionStorage.setItem('gsmIntroSeen','1'); }catch(e){}
    el.classList.add('gi-out');
    document.documentElement.classList.remove('gi-lock');
    setTimeout(kill, 650);
  }
  el.addEventListener('click', enter);
  document.addEventListener('keydown', enter);
})();
</script>
